# Salin menjadi .env.local. Hanya anon key yang boleh ada di frontend.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-dari-dashboard-supabase
# Kunci publik VAPID untuk Web Push (dibuat di Tahap 5)
VITE_VAPID_PUBLIC_KEY=
# JANGAN taruh service_role key di sini. Simpan hanya di secret Edge Functions.

# Lokasi dianggap kedaluwarsa setelah N menit tanpa pembaruan (opsional, default 5)
VITE_LOCATION_STALE_MINUTES=5
